[Unit]
Description=Open Harness cron runtime
Documentation=https://github.com/mifunedev/agro
Requires=openharness-bootstrap.service
After=openharness-bootstrap.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sandbox
WorkingDirectory=/home/sandbox/harness
Environment=HOME=/home/sandbox
ExecStart=/bin/bash -c 'if [ -d /home/sandbox/harness/.agro ]; then exec /usr/local/bin/node --experimental-strip-types /home/sandbox/harness/.agro/scripts/cron-runtime.ts; fi; exec /usr/local/bin/node --experimental-strip-types /home/sandbox/harness/.oh/scripts/cron-runtime.ts'
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=process
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
