{
  "name": "@mifune/agro",
  "version": "0.9.0",
  "description": "AGRO CLI — create sandboxes for coding agents and manage OpenHarness Cloud nodes.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mifunedev/agro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mifunedev/agro.git",
    "directory": ".agro/cli"
  },
  "bugs": {
    "url": "https://github.com/mifunedev/agro/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "agro": "./dist/agro.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "typecheck:build": "tsc --noEmit -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck:build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  }
}
