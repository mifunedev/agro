{
  "version": 1,
  "vectors": [
    { "id": "control-dir-absent", "kind": "control-dir", "fixture": { "README.md": "plain repo\n" }, "expect": { "kind": "absent", "generation": "agro", "path": ".agro" } },
    { "id": "control-dir-absent-with-legacy-config", "kind": "control-dir", "fixture": { "oh.json": "{}\n" }, "expect": { "kind": "absent", "generation": "agro", "path": ".agro" } },
    { "id": "control-dir-legacy-only", "kind": "control-dir", "fixture": { ".oh/README.md": "legacy\n" }, "expect": { "kind": "legacy-only", "generation": "legacy", "path": ".oh" } },
    { "id": "control-dir-agro-only", "kind": "control-dir", "fixture": { ".agro/README.md": "agro\n" }, "expect": { "kind": "agro-only", "generation": "agro", "path": ".agro" } },
    { "id": "control-dir-both-equivalent", "kind": "control-dir", "fixture": { ".oh/README.md": "same\n", ".oh/scripts/run.sh": { "content": "#!/bin/sh\n", "mode": "755" }, ".oh/link": { "symlink": "README.md" }, ".agro/README.md": "same\n", ".agro/scripts/run.sh": { "content": "#!/bin/sh\n", "mode": "755" }, ".agro/link": { "symlink": "README.md" } }, "expect": { "kind": "both-equivalent", "generation": "agro", "path": ".agro" } },
    { "id": "control-dir-empty-both", "kind": "control-dir", "fixture": { ".oh": { "dir": true }, ".agro": { "dir": true } }, "expect": { "kind": "both-equivalent", "generation": "agro", "path": ".agro" } },
    { "id": "control-dir-divergent-content", "kind": "control-dir", "fixture": { ".oh/README.md": "one\n", ".agro/README.md": "two\n" }, "expect": { "conflict": true, "differences": ["README.md: content differs"] } },
    { "id": "control-dir-divergent-mode", "kind": "control-dir", "fixture": { ".oh/scripts/run.sh": { "content": "#!/bin/sh\n", "mode": "755" }, ".agro/scripts/run.sh": { "content": "#!/bin/sh\n", "mode": "644" } }, "expect": { "conflict": true, "differences": ["scripts/run.sh: mode 755 vs 644"] } },
    { "id": "control-dir-divergent-symlink", "kind": "control-dir", "fixture": { ".oh/README.md": "x\n", ".oh/link": { "symlink": "README.md" }, ".agro/README.md": "x\n", ".agro/link": { "symlink": "elsewhere" } }, "expect": { "conflict": true, "differences": ["link: symlink target differs"] } },
    { "id": "control-dir-divergent-unknown-file", "kind": "control-dir", "fixture": { ".oh/README.md": "x\n", ".oh/custom/notes.txt": "mine\n", ".agro/README.md": "x\n" }, "expect": { "conflict": true, "differences": ["custom: only in"] } },
    { "id": "control-dir-divergent-type", "kind": "control-dir", "fixture": { ".oh/thing": "file\n", ".agro/thing/inner": "dir\n" }, "expect": { "conflict": true, "differences": ["thing: type file vs directory"] } },
    { "id": "control-dir-invalid-legacy-is-file", "kind": "control-dir", "fixture": { ".oh": "not a directory\n", ".agro/README.md": "agro\n" }, "expect": { "kind": "agro-only", "generation": "agro", "path": ".agro" } },
    { "id": "control-dir-invalid-agro-is-file", "kind": "control-dir", "fixture": { ".agro": "not a directory\n", ".oh/README.md": "legacy\n" }, "expect": { "kind": "legacy-only", "generation": "legacy", "path": ".oh" } },
    { "id": "config-absent", "kind": "config-file", "fixture": { "README.md": "plain repo\n" }, "expect": { "kind": "absent", "generation": "agro", "path": "agro.json" } },
    { "id": "config-absent-with-legacy-control-dir", "kind": "config-file", "fixture": { ".oh/README.md": "x\n" }, "expect": { "kind": "absent", "generation": "agro", "path": "agro.json" } },
    { "id": "config-legacy-only", "kind": "config-file", "fixture": { "oh.json": "{\"version\":1,\"name\":\"demo\"}\n" }, "expect": { "kind": "legacy-only", "generation": "legacy", "path": "oh.json" } },
    { "id": "config-agro-only", "kind": "config-file", "fixture": { "agro.json": "{\"version\":1,\"name\":\"demo\"}\n" }, "expect": { "kind": "agro-only", "generation": "agro", "path": "agro.json" } },
    { "id": "config-both-equivalent", "kind": "config-file", "fixture": { "oh.json": "{\"version\":1,\"name\":\"demo\"}\n", "agro.json": "{\"version\":1,\"name\":\"demo\"}\n" }, "expect": { "kind": "both-equivalent", "generation": "agro", "path": "agro.json" } },
    { "id": "config-both-empty", "kind": "config-file", "fixture": { "oh.json": "", "agro.json": "" }, "expect": { "kind": "both-equivalent", "generation": "agro", "path": "agro.json" } },
    { "id": "config-divergent-formatting-only", "kind": "config-file", "fixture": { "oh.json": "{\"version\":1,\"name\":\"demo\"}\n", "agro.json": "{\n  \"version\": 1,\n  \"name\": \"demo\"\n}\n" }, "expect": { "conflict": true, "differences": [": content differs"] } },
    { "id": "config-divergent-value", "kind": "config-file", "fixture": { "oh.json": "{\"version\":1,\"name\":\"one\"}\n", "agro.json": "{\"version\":1,\"name\":\"two\"}\n" }, "expect": { "conflict": true, "differences": [": content differs"] } },
    { "id": "config-divergent-mode", "kind": "config-file", "fixture": { "oh.json": { "content": "{}\n", "mode": "644" }, "agro.json": { "content": "{}\n", "mode": "600" } }, "expect": { "conflict": true, "differences": [": mode 644 vs 600"] } },
    { "id": "config-invalid-legacy-is-dir", "kind": "config-file", "fixture": { "oh.json/inner": "x\n", "agro.json": "{}\n" }, "expect": { "kind": "agro-only", "generation": "agro", "path": "agro.json" } },
    { "id": "env-unset", "kind": "env", "env": {}, "suffix": "HOME", "expect": { "value": null, "source": "none", "conflict": false } },
    { "id": "env-legacy-only", "kind": "env", "env": { "OH_HOME": "/legacy" }, "suffix": "HOME", "expect": { "value": "/legacy", "source": "legacy", "conflict": false } },
    { "id": "env-agro-only", "kind": "env", "env": { "AGRO_HOME": "/agro" }, "suffix": "HOME", "expect": { "value": "/agro", "source": "agro", "conflict": false } },
    { "id": "env-both-equal", "kind": "env", "env": { "AGRO_HOME": "/same", "OH_HOME": "/same" }, "suffix": "HOME", "expect": { "value": "/same", "source": "agro", "conflict": false } },
    { "id": "env-both-differ-agro-wins", "kind": "env", "env": { "AGRO_HOME": "/agro", "OH_HOME": "/legacy" }, "suffix": "HOME", "expect": { "value": "/agro", "source": "agro", "conflict": true } },
    { "id": "env-empty-agro-is-unset", "kind": "env", "env": { "AGRO_HOME": "", "OH_HOME": "/legacy" }, "suffix": "HOME", "expect": { "value": "/legacy", "source": "legacy", "conflict": false } },
    { "id": "env-empty-legacy-is-unset", "kind": "env", "env": { "AGRO_HOME": "/agro", "OH_HOME": "" }, "suffix": "HOME", "expect": { "value": "/agro", "source": "agro", "conflict": false } },
    { "id": "env-both-empty", "kind": "env", "env": { "AGRO_HOME": "", "OH_HOME": "" }, "suffix": "HOME", "expect": { "value": null, "source": "none", "conflict": false } },
    { "id": "env-unrelated-suffix", "kind": "env", "env": { "AGRO_HOME": "/agro" }, "suffix": "SANDBOX_IMAGE", "expect": { "value": null, "source": "none", "conflict": false } },
    { "id": "seed-default-agro-when-neither-exists", "kind": "seed", "env": {}, "fixture": {}, "expect": { "path": "/opt/agro-seed" } },
    { "id": "seed-legacy-only", "kind": "seed", "env": {}, "fixture": { "opt/oh-seed/.oh/README.md": "x\n" }, "expect": { "path": "/opt/oh-seed" } },
    { "id": "seed-agro-only", "kind": "seed", "env": {}, "fixture": { "opt/agro-seed/.agro/README.md": "x\n" }, "expect": { "path": "/opt/agro-seed" } },
    { "id": "seed-both-present-keeps-legacy-default", "kind": "seed", "env": {}, "fixture": { "opt/oh-seed/.oh/README.md": "x\n", "opt/agro-seed/.agro/README.md": "x\n" }, "expect": { "path": "/opt/oh-seed" } },
    { "id": "seed-legacy-env-override", "kind": "seed", "env": { "OH_IMAGE_SEED_SRC": "/custom/legacy" }, "fixture": { "opt/agro-seed/.agro/README.md": "x\n" }, "expect": { "path": "/custom/legacy" } },
    { "id": "seed-agro-env-wins", "kind": "seed", "env": { "AGRO_IMAGE_SEED_SRC": "/custom/agro", "OH_IMAGE_SEED_SRC": "/custom/legacy" }, "fixture": {}, "expect": { "path": "/custom/agro", "conflict": true } }
  ]
}
