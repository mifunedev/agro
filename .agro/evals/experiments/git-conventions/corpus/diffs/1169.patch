+
+  it("reloads the guard every time xrdp starts, so it holds across reboots", () => {
+    expect(script).toContain(
+      `printf '[Service]\\nExecStartPre=%s -f ${RULES}\\n' "$(command -v nft)" > ${DROP_IN}`,
