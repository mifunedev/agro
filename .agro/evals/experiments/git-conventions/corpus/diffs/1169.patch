+      'echo "  sudo passwd $user"',
+    ]);
+  });
+
+  it("ends by printing the two remaining operator steps", () => {
+    expect(script.split("\n").slice(-3)).toEqual([
+      'echo "The desktop is installed. Two steps remain:"',
+      'echo "  sudo tailscale up"',
+      'echo "  sudo passwd $user"',
+    ]);
+  });
+});
